<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Fonts.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--
        TimePicker is intentionally NOT overridden here - it has no separately-named default style
        resource in the WinUI SDK (its full template sits directly under the bare implicit style), so
        it's covered by ThemeFontFallback.xaml instead. CalendarDatePicker's default style key is
        "DefaultCalendarDatePicker" (no "Style" suffix) - that's a real WinUI SDK naming quirk, not a typo.
    -->

    <Style BasedOn="{StaticResource DefaultCalendarViewStyle}" TargetType="CalendarView">
        <Setter Property="FontFamily" Value="{StaticResource InterVariableFont}" />
    </Style>

    <Style BasedOn="{StaticResource DefaultCalendarDatePicker}" TargetType="CalendarDatePicker">
        <Setter Property="FontFamily" Value="{StaticResource InterVariableFont}" />
    </Style>

    <Style BasedOn="{StaticResource DefaultDatePickerStyle}" TargetType="DatePicker">
        <Setter Property="FontFamily" Value="{StaticResource InterVariableFont}" />
    </Style>
</ResourceDictionary>
