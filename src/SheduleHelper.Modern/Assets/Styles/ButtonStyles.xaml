<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Fonts.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!--
        Each style is BasedOn the control's real default style (from the WinUI SDK's generic.xaml)
        so every other property - colors, padding, corner radius, visual states - is untouched;
        only FontFamily is overridden.
    -->

    <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="FontFamily" Value="{StaticResource InterVariableFont}" />
    </Style>

    <Style TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
        <Setter Property="FontFamily" Value="{StaticResource InterVariableFont}" />
    </Style>

    <Style TargetType="RepeatButton" BasedOn="{StaticResource DefaultRepeatButtonStyle}">
        <Setter Property="FontFamily" Value="{StaticResource InterVariableFont}" />
    </Style>

    <Style TargetType="HyperlinkButton" BasedOn="{StaticResource DefaultHyperlinkButtonStyle}">
        <Setter Property="FontFamily" Value="{StaticResource InterVariableFont}" />
    </Style>

    <Style TargetType="DropDownButton" BasedOn="{StaticResource DefaultDropDownButtonStyle}">
        <Setter Property="FontFamily" Value="{StaticResource InterVariableFont}" />
    </Style>

    <Style TargetType="AppBarButton" BasedOn="{StaticResource DefaultAppBarButtonStyle}">
        <Setter Property="FontFamily" Value="{StaticResource InterVariableFont}" />
    </Style>

    <Style TargetType="AppBarToggleButton" BasedOn="{StaticResource DefaultAppBarToggleButtonStyle}">
        <Setter Property="FontFamily" Value="{StaticResource InterVariableFont}" />
    </Style>

    <Style TargetType="RadioButton" BasedOn="{StaticResource DefaultRadioButtonStyle}">
        <Setter Property="FontFamily" Value="{StaticResource InterVariableFont}" />
    </Style>

    <Style TargetType="RadioButtons" BasedOn="{StaticResource DefaultRadioButtonsStyle}">
        <Setter Property="FontFamily" Value="{StaticResource InterVariableFont}" />
    </Style>

    <Style TargetType="CheckBox" BasedOn="{StaticResource DefaultCheckBoxStyle}">
        <Setter Property="FontFamily" Value="{StaticResource InterVariableFont}" />
    </Style>

    <Style TargetType="ToggleSwitch" BasedOn="{StaticResource DefaultToggleSwitchStyle}">
        <Setter Property="FontFamily" Value="{StaticResource InterVariableFont}" />
    </Style>
</ResourceDictionary>
