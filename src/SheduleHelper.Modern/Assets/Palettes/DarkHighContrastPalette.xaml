    <!--
        Material Theme Builder palette (DarkHighContrast), generated from dark-hc.css.
        Each -md-sys-color-* token becomes an Md{Token}Color / Md{Token}Brush pair. Swap the
        active palette dictionary in App.xaml's MergedDictionaries to switch themes at runtime.
    -->
