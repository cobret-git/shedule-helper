<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SheduleHelper.Modern.View.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SheduleHelper.Modern.Controls"
    xmlns:converters="using:SheduleHelper.Modern.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:SheduleHelper.Modern.Components.Helpers"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Page.Resources>
        <converters:DecimalToDoubleConverter x:Key="DecimalToDoubleConverter" />
        <converters:Int32ToDoubleConverter x:Key="Int32ToDoubleConverter" />
        <converters:TimeOnlyToTimeSpanConverter x:Key="TimeOnlyToTimeSpanConverter" />
        <converters:LunchStrategyDisplayConverter x:Key="LunchStrategyDisplayConverter" />
        <converters:LunchStrategyToBooleanConverter x:Key="LunchStrategyToBooleanConverter" />
        <converters:CultureDisplayConverter x:Key="CultureDisplayConverter" />
    </Page.Resources>

    <Grid Padding="24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="4">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{local:LocalizedString Key=settings_page_title}" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource BodyTextBlockStyle}"
                Text="{local:LocalizedString Key=settings_page_subtitle}" />
        </StackPanel>

        <InfoBar
            Grid.Row="1"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.MessageVisible, Mode=OneWay}"
            Message="{x:Bind ViewModel.Message, Mode=OneWay}"
            Severity="Error" />

        <ScrollViewer Grid.Row="2">
            <StackPanel Spacing="8">
                <controls:SettingsCard Description="{local:LocalizedString Key=settings_targetShiftHours_description}" Header="{local:LocalizedString Key=settings_targetShiftHours_header}">
                    <controls:SettingsCard.HeaderIcon>
                        <SymbolIcon Symbol="Clock" />
                    </controls:SettingsCard.HeaderIcon>
                    <NumberBox
                        Width="140"
                        LargeChange="1"
                        Maximum="24"
                        Minimum="0"
                        SmallChange="0.25"
                        SpinButtonPlacementMode="Compact"
                        Value="{x:Bind ViewModel.TargetShiftHours, Mode=TwoWay, Converter={StaticResource DecimalToDoubleConverter}}" />
                </controls:SettingsCard>

                <controls:SettingsCard Description="{local:LocalizedString Key=settings_defaultClockIn_description}" Header="{local:LocalizedString Key=settings_defaultClockIn_header}">
                    <controls:SettingsCard.HeaderIcon>
                        <SymbolIcon Symbol="Play" />
                    </controls:SettingsCard.HeaderIcon>
                    <TimePicker ClockIdentifier="24HourClock" Time="{x:Bind ViewModel.DefaultClockInTime, Mode=TwoWay, Converter={StaticResource TimeOnlyToTimeSpanConverter}}" />
                </controls:SettingsCard>

                <controls:SettingsCard Description="{local:LocalizedString Key=settings_defaultClockOut_description}" Header="{local:LocalizedString Key=settings_defaultClockOut_header}">
                    <controls:SettingsCard.HeaderIcon>
                        <SymbolIcon Symbol="Stop" />
                    </controls:SettingsCard.HeaderIcon>
                    <TimePicker ClockIdentifier="24HourClock" Time="{x:Bind ViewModel.DefaultClockOutTime, Mode=TwoWay, Converter={StaticResource TimeOnlyToTimeSpanConverter}}" />
                </controls:SettingsCard>

                <controls:SettingsCard Description="{local:LocalizedString Key=settings_lunchStrategy_description}" Header="{local:LocalizedString Key=settings_lunchStrategy_header}">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE706;" />
                    </controls:SettingsCard.HeaderIcon>
                    <ComboBox
                        Width="180"
                        ItemsSource="{x:Bind ViewModel.LunchStrategyOptions}"
                        SelectedItem="{x:Bind ViewModel.LunchStrategy, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource LunchStrategyDisplayConverter}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </controls:SettingsCard>

                <controls:SettingsCard
                    Description="{local:LocalizedString Key=settings_lunchWindowStart_description}"
                    Header="{local:LocalizedString Key=settings_lunchWindowStart_header}"
                    IsEnabled="{x:Bind ViewModel.LunchStrategy, Mode=OneWay, Converter={StaticResource LunchStrategyToBooleanConverter}, ConverterParameter=FixedWindow}">
                    <TimePicker ClockIdentifier="24HourClock" Time="{x:Bind ViewModel.LunchStartTime, Mode=TwoWay, Converter={StaticResource TimeOnlyToTimeSpanConverter}}" />
                </controls:SettingsCard>

                <controls:SettingsCard
                    Description="{local:LocalizedString Key=settings_lunchWindowEnd_description}"
                    Header="{local:LocalizedString Key=settings_lunchWindowEnd_header}"
                    IsEnabled="{x:Bind ViewModel.LunchStrategy, Mode=OneWay, Converter={StaticResource LunchStrategyToBooleanConverter}, ConverterParameter=FixedWindow}">
                    <TimePicker ClockIdentifier="24HourClock" Time="{x:Bind ViewModel.LunchEndTime, Mode=TwoWay, Converter={StaticResource TimeOnlyToTimeSpanConverter}}" />
                </controls:SettingsCard>

                <controls:SettingsCard
                    Description="{local:LocalizedString Key=settings_lunchDuration_description}"
                    Header="{local:LocalizedString Key=settings_lunchDuration_header}"
                    IsEnabled="{x:Bind ViewModel.LunchStrategy, Mode=OneWay, Converter={StaticResource LunchStrategyToBooleanConverter}, ConverterParameter=DurationBased}">
                    <NumberBox
                        Width="140"
                        Maximum="180"
                        Minimum="0"
                        SmallChange="5"
                        SpinButtonPlacementMode="Compact"
                        Value="{x:Bind ViewModel.LunchDurationMinutes, Mode=TwoWay, Converter={StaticResource Int32ToDoubleConverter}}" />
                </controls:SettingsCard>
                <controls:SettingsCard Description="{local:LocalizedString Key=settings_theme_description}" Header="{local:LocalizedString Key=settings_theme_header}">
                    <!--<controls:SettingsCard.HeaderIcon>
                        <SymbolIcon Symbol="Bri" />
                    </controls:SettingsCard.HeaderIcon>-->
                    <ComboBox
                        Width="140"
                        ItemsSource="{x:Bind ViewModel.ThemeOptions}"
                        SelectedItem="{x:Bind ViewModel.Theme, Mode=TwoWay}" />
                </controls:SettingsCard>

                <controls:SettingsCard Description="{local:LocalizedString Key=settings_language_description}" Header="{local:LocalizedString Key=settings_language_header}">
                    <controls:SettingsCard.HeaderIcon>
                        <FontIcon Glyph="&#xE12C;" />
                    </controls:SettingsCard.HeaderIcon>
                    <ComboBox
                        Width="180"
                        ItemsSource="{x:Bind ViewModel.CultureOptions}"
                        SelectedItem="{x:Bind ViewModel.Culture, Mode=TwoWay}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Converter={StaticResource CultureDisplayConverter}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </controls:SettingsCard>

                <TextBlock
                    FontFamily="{StaticResource MaterialIconsRoundedFont}"
                    FontSize="72"
                    Text="&#xe14b;" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel
            Grid.Row="3"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="8">
            <ProgressRing
                Width="20"
                Height="20"
                Margin="0,0,8,0"
                IsActive="{x:Bind ViewModel.IsBusy, Mode=OneWay}" />
            <Button Command="{x:Bind ViewModel.DiscardChangesCommand}" Content="{local:LocalizedString Key=settings_discard_button}" />
            <Button
                Command="{x:Bind ViewModel.SaveChangesCommand}"
                Content="{local:LocalizedString Key=settings_save_button}"
                Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>
    </Grid>
</Page>
