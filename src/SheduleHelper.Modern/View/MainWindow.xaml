<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="SheduleHelper.Modern.View.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:SheduleHelper.Modern.View"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="SheduleHelper.Modern"
    mc:Ignorable="d">

    <Grid
        x:Name="RootGrid"
        Background="{ThemeResource MdBackgroundBrush}"
        Loaded="RootGrid_Loaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="titleBar"
            Title="SheduleHelper.Modern"
            Grid.Row="0"
            BackRequested="TitleBar_BackRequested"
            FontFamily="{StaticResource InterVariableFont}"
            Foreground="{ThemeResource MdOnBackgroundBrush}"
            IsBackButtonVisible="False"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="TitleBar_PaneToggleRequested" />

        <BreadcrumbBar
            x:Name="AppBreadcrumbBar"
            Grid.Row="0"
            Margin="16,12"
            ItemClicked="AppBreadcrumbBar_ItemClicked"
            ItemsSource="{x:Bind NavigationService.Breadcrumbs}"
            Visibility="Collapsed" />

        <NavigationView
            x:Name="nv"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            IsSettingsVisible="False"
            SelectionChanged="NavigationView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Home" Tag="home">
                    <NavigationViewItem.Icon>
                        <FontIcon
                            FontFamily="{StaticResource MaterialIconsRoundedFilledFont}"
                            Glyph="&#xe88a;"
                            RenderTransformOrigin="0.5 0.5">
                            <FontIcon.RenderTransform>
                                <ScaleTransform ScaleX="1.6" ScaleY="1.6" />
                            </FontIcon.RenderTransform>
                        </FontIcon>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Projects &amp; Tasks" Tag="projectsAndTasks">
                    <NavigationViewItem.Icon>
                        <FontIcon
                            FontFamily="{StaticResource MaterialIconsRoundedFilledFont}"
                            Glyph="&#xe85d;"
                            RenderTransformOrigin="0.5 0.5">
                            <FontIcon.RenderTransform>
                                <ScaleTransform ScaleX="1.6" ScaleY="1.6" />
                            </FontIcon.RenderTransform>
                        </FontIcon>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="History &amp; Reports" Tag="historyAndReports">
                    <NavigationViewItem.Icon>
                        <FontIcon
                            FontFamily="{StaticResource MaterialIconsRoundedFilledFont}"
                            Glyph="&#xebcc;"
                            RenderTransformOrigin="0.5 0.5">
                            <FontIcon.RenderTransform>
                                <ScaleTransform ScaleX="1.6" ScaleY="1.6" />
                            </FontIcon.RenderTransform>
                        </FontIcon>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Settings" Tag="settings">
                    <NavigationViewItem.Icon>
                        <FontIcon
                            FontFamily="{StaticResource MaterialIconsRoundedFilledFont}"
                            Glyph="&#xe8b8;"
                            RenderTransformOrigin="0.5 0.5">
                            <FontIcon.RenderTransform>
                                <ScaleTransform ScaleX="1.6" ScaleY="1.6" />
                            </FontIcon.RenderTransform>
                        </FontIcon>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>
            <Frame x:Name="ContentFrame" Padding="0,9,10,0" />
        </NavigationView>
    </Grid>
</Window>
