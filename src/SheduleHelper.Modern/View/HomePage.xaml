<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="SheduleHelper.Modern.View.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:SheduleHelper.Modern.Controls"
    xmlns:converters="using:SheduleHelper.Modern.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:strings="using:SheduleHelper.Core.Resources.Strings"
    mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Assets/Styles/Fonts.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <converters:AttendanceDayStateToVisibilityConverter x:Key="DayStateToVisibility" />
            <converters:TimeOnlyToTimeSpanConverter x:Key="TimeOnlyToTimeSpanConverter" />
            <converters:TimeSpanToMinutesConverter x:Key="TimeSpanToMinutesConverter" />

            <Style x:Key="CardBorderStyle" TargetType="Border">
                <Setter Property="Padding" Value="24" />
                <Setter Property="Background" Value="{ThemeResource MdSurfaceContainerLowBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource MdOutlineVariantBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
            </Style>
        </ResourceDictionary>
    </Page.Resources>

    <Grid
        MaxWidth="1400"
        Padding="0"
        RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Border
                Grid.Column="0"
                MinHeight="130"
                Style="{StaticResource CardBorderStyle}">
                <StackPanel Orientation="Vertical">
                    <TextBlock
                        FontSize="14"
                        FontWeight="Medium"
                        Foreground="{ThemeResource MdOnSurfaceVariantBrush}"
                        Text="LIVE MONTHLY BUDGET" />
                    <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                        <TextBlock
                            FontSize="32"
                            FontWeight="Bold"
                            Foreground="{ThemeResource MdPrimaryBrush}"
                            Text="+2.5h" />
                        <Border
                            Margin="8,0,0,0"
                            Padding="8,2"
                            VerticalAlignment="Bottom"
                            Background="{ThemeResource MdTertiaryFixedBrush}">
                            <TextBlock
                                FontSize="14"
                                Foreground="{ThemeResource MdOnTertiaryFixedVariantBrush}"
                                Text="Over Target" />
                        </Border>
                    </StackPanel>
                    <TextBlock
                        Margin="0,16,0,0"
                        Text="Cumulative balance calculated until Oct 24. You are maintaining an optimal efficiency ratio."
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}">
                <StackPanel Orientation="Vertical">
                    <TextBlock
                        FontSize="14"
                        FontWeight="Medium"
                        Foreground="{ThemeResource MdOnSurfaceVariantBrush}"
                        Text="TODAY'S PROGRESS" />
                    <StackPanel
                        Margin="0,4,0,0"
                        Orientation="Horizontal"
                        Spacing="4">
                        <TextBlock
                            FontSize="24"
                            FontWeight="Bold"
                            Foreground="{ThemeResource MdOnSurfaceBrush}"
                            Text="5h 15m" />
                        <TextBlock
                            VerticalAlignment="Bottom"
                            Foreground="{ThemeResource MdOnSurfaceVariantBrush}"
                            Text="/8h 00m" />
                    </StackPanel>
                    <ProgressBar
                        MinHeight="12"
                        Margin="0,42,0,0"
                        Background="{ThemeResource MdSurfaceContainerHighestBrush}"
                        CornerRadius="6"
                        Foreground="{ThemeResource MdPrimaryBrush}"
                        Maximum="100"
                        Minimum="0"
                        Value="60" />
                    <Grid Margin="0,4,0,0">
                        <TextBlock
                            HorizontalAlignment="Left"
                            FontSize="11"
                            Foreground="{ThemeResource MdOnSurfaceVariantBrush}"
                            Text="65% Complete" />
                        <TextBlock
                            HorizontalAlignment="Right"
                            FontSize="11"
                            Foreground="{ThemeResource MdOnSurfaceVariantBrush}"
                            Text="2h 45m left" />
                    </Grid>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource CardBorderStyle}">
                <StackPanel Orientation="Vertical" />
            </Border>
        </Grid>

        <Grid Grid.Row="1">
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="16">
                    <TextBlock
                        FontSize="20"
                        FontWeight="SemiBold"
                        Text="{x:Bind strings:Content.daily_timeline_header}" />
                    <controls:TimelineBar ItemsSource="{x:Bind ViewModel.TodaysTimeline, Mode=OneWay}" />
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</Page>
