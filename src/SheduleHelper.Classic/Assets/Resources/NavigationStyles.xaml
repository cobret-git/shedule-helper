<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ================================================ -->
    <!--   DEFAULT TABITEM STYLE                         -->
    <!--   Material Design Tab Item                       -->
    <!-- ================================================ -->

    <Style x:Key="DefaultTabItemStyle" TargetType="{x:Type TabItem}">
        <!-- Base Properties -->
        <Setter Property="Foreground" Value="{DynamicResource DefaultControlForegroundDefaultBrush}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="MinWidth" Value="80"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabItem}">
                    <Grid x:Name="Root" Background="Transparent">
                        <!-- Tab Header -->
                        <Border x:Name="HeaderBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="ContentSite"
                                            Margin="{TemplateBinding Padding}"
                                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                            ContentSource="Header"
                                            RecognizesAccessKey="True"
                                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>

                        <!-- Active Indicator (Bottom Border) -->
                        <Border x:Name="ActiveIndicator"
                                Height="3"
                                Background="{DynamicResource AccentPrimaryBrush}"
                                VerticalAlignment="Bottom"
                                HorizontalAlignment="Stretch"
                                Opacity="0"
                                SnapsToDevicePixels="True"/>
                    </Grid>

                    <ControlTemplate.Triggers>

                        <!-- Hover State -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="HeaderBorder" Property="Background"
                                    Value="{DynamicResource DefaultControlBackgroundHoverBrush}"/>
                        </Trigger>

                        <!-- Selected State -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource AccentPrimaryBrush}"/>
                            <Setter TargetName="ActiveIndicator" Property="Opacity" Value="1"/>
                            <Setter Property="FontWeight" Value="SemiBold"/>
                        </Trigger>

                        <!-- Selected + Hover -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="HeaderBorder" Property="Background"
                                    Value="{DynamicResource DefaultControlBackgroundHoverBrush}"/>
                            <Setter TargetName="ActiveIndicator" Property="Background"
                                    Value="{DynamicResource AccentPrimaryHoverBrush}"/>
                        </MultiTrigger>

                        <!-- Disabled State -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ContentSite" Property="Opacity"
                                    Value="{DynamicResource DefaultControlDisabledOpacity}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>

                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TabItem" BasedOn="{StaticResource DefaultTabItemStyle}"/>

    <!-- ================================================ -->
    <!--   DEFAULT TABCONTROL STYLE                      -->
    <!--   Material Design Tab Control                    -->
    <!-- ================================================ -->

    <Style x:Key="DefaultTabControlStyle" TargetType="{x:Type TabControl}">
        <!-- Base Properties -->
        <Setter Property="Foreground" Value="{DynamicResource DefaultControlForegroundDefaultBrush}"/>
        <Setter Property="Background" Value="{DynamicResource LayerBackgroundFloatingBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DefaultControlBorderDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabControl}">
                    <Grid x:Name="TemplateRoot"
                          Background="{TemplateBinding Background}"
                          ClipToBounds="True"
                          SnapsToDevicePixels="True">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Tab Strip Container -->
                        <Border x:Name="HeaderBorder"
                                Grid.Row="0"
                                Background="Transparent"
                                BorderBrush="{DynamicResource DefaultControlBorderDefaultBrush}"
                                BorderThickness="0,0,0,1"
                                SnapsToDevicePixels="True">
                            <TabPanel x:Name="HeaderPanel"
                                    IsItemsHost="True"
                                    Margin="0"
                                    Panel.ZIndex="1"
                                    Background="Transparent"
                                    KeyboardNavigation.TabIndex="1"/>
                        </Border>

                        <!-- Content Container -->
                        <Border x:Name="ContentPanel"
                                Grid.Row="1"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                            ContentSource="SelectedContent"
                                            Margin="0"
                                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <!-- Disabled State -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="TemplateRoot" Property="Opacity"
                                    Value="{DynamicResource DefaultControlDisabledOpacity}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="TabControl" BasedOn="{StaticResource DefaultTabControlStyle}"/>

    <!-- ================================================ -->
    <!--   HEADERLESS TABCONTROL STYLE                   -->
    <!--   For custom navigation (sidebar, etc.)          -->
    <!-- ================================================ -->

    <Style x:Key="HeaderlessTabControlStyle" TargetType="{x:Type TabControl}">
        <!-- Base Properties -->
        <Setter Property="Foreground" Value="{DynamicResource DefaultControlForegroundDefaultBrush}"/>
        <Setter Property="Background" Value="{DynamicResource LayerBackgroundFloatingBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource DefaultControlBorderDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Stretch"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabControl}">
                    <Border x:Name="ContentPanel"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}"
                            CornerRadius="6,6,0,0"
                            SnapsToDevicePixels="True">
                        <ContentPresenter x:Name="PART_SelectedContentHost"
                                        ContentSource="SelectedContent"
                                        Margin="0"
                                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                    </Border>

                    <ControlTemplate.Triggers>
                        <!-- Disabled State -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ContentPanel" Property="Opacity"
                                    Value="{DynamicResource DefaultControlDisabledOpacity}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================ -->
    <!--   NAVIGATION LISTBOX STYLE                      -->
    <!--   For sidebar navigation items                   -->
    <!-- ================================================ -->

    <Style x:Key="NavigationListBoxStyle" TargetType="{x:Type ListBox}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
        <Setter Property="ScrollViewer.CanContentScroll" Value="False"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBox}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            SnapsToDevicePixels="True">
                        <ScrollViewer Padding="{TemplateBinding Padding}" Focusable="False">
                            <ItemsPresenter SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================ -->
    <!--   NAVIGATION LISTBOXITEM STYLE                  -->
    <!--   GitHub-style navigation button                 -->
    <!-- ================================================ -->

    <!-- ================================================ -->
    <!--   NAVIGATION ICON STYLES                        -->
    <!--   Auto-bind Fill to parent's Foreground          -->
    <!-- ================================================ -->

    <!-- For Path icons -->
    <Style x:Key="NavigationIconStyle" TargetType="{x:Type Path}">
        <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
        <Setter Property="Stretch" Value="Uniform"/>
    </Style>

    <!-- For DrawingBrush icons (Rectangle with OpacityMask) -->
    <Style x:Key="NavigationDrawingIconStyle" TargetType="{x:Type Rectangle}">
        <Setter Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"/>
    </Style>

    <!-- ================================================ -->
    <!--   ICON BUTTON STYLE                             -->
    <!--   Small icon-only button (16x16)                -->
    <!-- ================================================ -->

    <Style x:Key="IconButtonStyle" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="Width" Value="16"/>
        <Setter Property="Height" Value="16"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Grid Background="Transparent">
                        <ContentPresenter x:Name="ContentPresenter"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        RecognizesAccessKey="True"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ContentPresenter" Property="Opacity"
                                    Value="{DynamicResource DefaultControlDisabledOpacity}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Icon style for IconButton (Path) -->
    <Style x:Key="IconButtonIconStyle" TargetType="{x:Type Path}">
        <Setter Property="Fill" Value="{DynamicResource DefaultControlForegroundDefaultBrush}"/>
        <Setter Property="Stretch" Value="Uniform"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                <Setter Property="Fill" Value="{DynamicResource AccentPrimaryBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Icon style for IconButton (Rectangle with OpacityMask) -->
    <Style x:Key="IconButtonDrawingIconStyle" TargetType="{x:Type Rectangle}">
        <Setter Property="Fill" Value="{DynamicResource DefaultControlForegroundDefaultBrush}"/>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}" Value="True">
                <Setter Property="Fill" Value="{DynamicResource AccentPrimaryBrush}"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="NavigationListBoxItemStyle" TargetType="{x:Type ListBoxItem}">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource DefaultControlForegroundDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="8,6"/>
        <Setter Property="Margin" Value="4,1"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="Normal"/>

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type ListBoxItem}">
                    <Grid x:Name="RootGrid" Margin="{TemplateBinding Margin}" Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="4"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left Indicator (GitHub-style) - rounded rectangle -->
                        <Border x:Name="LeftIndicator"
                                Grid.Column="0"
                                Width="4"
                                Height="24"
                                Background="{DynamicResource AccentPrimaryBrush}"
                                CornerRadius="2"
                                VerticalAlignment="Center"
                                Opacity="0"
                                SnapsToDevicePixels="True"/>

                        <!-- Content Background - fully rounded, separate from indicator -->
                        <Border x:Name="ContentBackground"
                                Grid.Column="2"
                                Background="Transparent"
                                CornerRadius="6"
                                SnapsToDevicePixels="True">
                            <!-- Content Presenter -->
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <!-- Hover State -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ContentBackground" Property="Background"
                                    Value="{DynamicResource DefaultControlBackgroundHoverBrush}"/>
                        </Trigger>

                        <!-- Selected State -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ContentBackground" Property="Background"
                                    Value="{DynamicResource LayerBackgroundElevatedBrush}"/>
                            <Setter TargetName="LeftIndicator" Property="Opacity" Value="1"/>
                        </Trigger>

                        <!-- Selected + Hover -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True"/>
                                <Condition Property="IsMouseOver" Value="True"/>
                            </MultiTrigger.Conditions>
                            <Setter TargetName="ContentBackground" Property="Background"
                                    Value="{DynamicResource DefaultControlBackgroundPressedBrush}"/>
                            <Setter TargetName="LeftIndicator" Property="Background"
                                    Value="{DynamicResource AccentPrimaryHoverBrush}"/>
                        </MultiTrigger>

                        <!-- Disabled State -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="{DynamicResource DefaultControlDisabledOpacity}"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
