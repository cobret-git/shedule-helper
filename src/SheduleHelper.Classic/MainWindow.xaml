<controls:CustomWindow x:Class="SheduleHelper.WpfApp.MainWindow"
                       xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                       xmlns:view="clr-namespace:SheduleHelper.WpfApp.View"
                       xmlns:controls="clr-namespace:SheduleHelper.WpfApp.Controls"
                       mc:Ignorable="d" Style="{StaticResource DefaultCustomWindowStyle}"
                       Title="Schedule Helper" Height="450" Width="800">

    <Grid Margin="0">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" MinWidth="240" MaxWidth="360"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border x:Name="Sidebar_Border" Grid.Column="0" HorizontalAlignment="Stretch"
                Background="{DynamicResource LayerBackgroundSubtleBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Padding="16,8" Height="48" HorizontalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Viewbox Width="24" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" Stretch="Uniform">
                            <Canvas Name="svg17" Width="48" Height="48">
                                <Canvas.RenderTransform>
                                    <TranslateTransform X="0" Y="0"/>
                                </Canvas.RenderTransform>
                                <Canvas.Resources>
                                    <LinearGradientBrush xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Key="gcb" MappingMode="RelativeToBoundingBox" StartPoint="0,0" EndPoint="0,1">
                                        <LinearGradientBrush.GradientStops>
                                            <GradientStopCollection>
                                                <GradientStop Color="#3F7057" Offset="0"/>
                                                <GradientStop Color="#2F5A46" Offset="1"/>
                                            </GradientStopCollection>
                                        </LinearGradientBrush.GradientStops>
                                    </LinearGradientBrush>
                                </Canvas.Resources>
                                
                                <Rectangle xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Canvas.Left="0" Canvas.Top="5" Width="48" Height="43" RadiusX="2" RadiusY="2" Name="rect9" Fill="{StaticResource gcb}"/>
                                <Rectangle xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Canvas.Left="6" Canvas.Top="0" Width="12" Height="12" RadiusX="1" RadiusY="1" Name="rect11" Fill="#FF4C8A6C"/>
                                <Rectangle xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Canvas.Left="30" Canvas.Top="0" Width="12" Height="12" RadiusX="1" RadiusY="1" Name="rect13" Fill="#FF4C8A6C"/>
                                <Path xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Name="path15" StrokeThickness="4" Stroke="#FF6EC2B2" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
                                    <Path.Data>
                                        <PathGeometry Figures="M15 27l8 8 14-14" FillRule="NonZero"/>
                                    </Path.Data>
                                </Path>
                            </Canvas>
                        </Viewbox>

                        <TextBlock Text="Shedule Helper" FontSize="16" FontWeight="Medium" HorizontalAlignment="Left"
                                   VerticalAlignment="Center" Margin="9,0,0,0"
                                   Foreground="{DynamicResource DefaultControlForegroundDefaultBrush}"/>
                    </StackPanel>
                </Border>

                <!-- Top items to navigate (main tabs) -->
                <ScrollViewer Grid.Row="1"
                              WindowChrome.IsHitTestVisibleInChrome="True" 
                              HorizontalScrollBarVisibility="Disabled" 
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel Orientation="Vertical">
                        <Border Padding="8,0,8,8" Margin="0,0,0,0">
                            <TextBlock Text="Tabs" FontFamily="Segoe UI Semibold" Opacity="0.8" FontSize="12" Foreground="{DynamicResource DefaultControlForegroundDefaultBrush}"/>
                        </Border>
                        <ListBox x:Name="MainNavigation"
                                 Style="{StaticResource NavigationListBoxStyle}"
                                 ItemContainerStyle="{StaticResource NavigationListBoxItemStyle}"
                                 SelectionChanged="MainNavigation_SelectionChanged"
                                 Padding="0,0,8,0">
                            <ListBoxItem Content="Dashboard"/>
                            <ListBoxItem Content="Schedule"/>
                            <ListBoxItem Content="Tasks"/>
                        </ListBox>
                        <Border x:Name="ProjectsSection" Padding="8,0,8,8" Margin="0,8,0,0">
                            <Grid>
                                <TextBlock Text="Projects" FontFamily="Segoe UI Semibold" Opacity="0.8" FontSize="12"
                                           Foreground="{DynamicResource DefaultControlForegroundDefaultBrush}"/>
                                <Button x:Name="AddProjectButton"
                                        Style="{StaticResource IconButtonStyle}"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        ToolTip="Add new project"
                                        Visibility="Collapsed">
                                    <Viewbox Height="12" Width="12">
                                        <Path Style="{StaticResource IconButtonIconStyle}"
                                          Data="M 8,2 L 8,14 M 2,8 L 14,8"
                                          Stroke="{Binding Fill, RelativeSource={RelativeSource Self}}"
                                          StrokeThickness="1.5"/>
                                    </Viewbox>
                                </Button>
                            </Grid>
                            <Border.Triggers>
                                <EventTrigger RoutedEvent="MouseEnter">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="AddProjectButton"
                                                                         Storyboard.TargetProperty="Visibility">
                                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                                <EventTrigger RoutedEvent="MouseLeave">
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="AddProjectButton"
                                                                         Storyboard.TargetProperty="Visibility">
                                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Collapsed}"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </EventTrigger>
                            </Border.Triggers>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
                

                <!-- Bottom items to navigate (settings) -->
                <ListBox x:Name="BottomNavigation"
                         Grid.Row="2"
                         Style="{StaticResource NavigationListBoxStyle}"
                         ItemContainerStyle="{StaticResource NavigationListBoxItemStyle}"
                         SelectionChanged="BottomNavigation_SelectionChanged"
                         Padding="8">
                    <ListBoxItem>
                        <StackPanel Orientation="Horizontal">
                            <Viewbox Width="16" Height="16">
                                <Rectangle Width="16" Height="16"
                                           Style="{StaticResource NavigationDrawingIconStyle}">
                                    <Rectangle.OpacityMask>
                                        <DrawingBrush Stretch="Uniform">
                                            <DrawingBrush.Drawing>
                                                <DrawingGroup>
                                                    <DrawingGroup.ClipGeometry>
                                                        <RectangleGeometry Rect="0,0,16,16"/>
                                                    </DrawingGroup.ClipGeometry>
                                                    <GeometryDrawing Brush="Black">
                                                        <GeometryDrawing.Geometry>
                                                            <PathGeometry Figures="M 8 4.754 a 3.246 3.246 0 1 0 0 6.492 a 3.246 3.246 0 0 0 0 -6.492 M 5.754 8 a 2.246 2.246 0 1 1 4.492 0 a 2.246 2.246 0 0 1 -4.492 0" FillRule="Nonzero"/>
                                                        </GeometryDrawing.Geometry>
                                                    </GeometryDrawing>
                                                    <GeometryDrawing Brush="Black">
                                                        <GeometryDrawing.Geometry>
                                                            <PathGeometry Figures="M 9.796 1.343 c -0.527 -1.79 -3.065 -1.79 -3.592 0 l -0.094 0.319 a 0.873 0.873 0 0 1 -1.255 0.52 l -0.292 -0.16 c -1.64 -0.892 -3.433 0.902 -2.54 2.541 l 0.159 0.292 a 0.873 0.873 0 0 1 -0.52 1.255 l -0.319 0.094 c -1.79 0.527 -1.79 3.065 0 3.592 l 0.319 0.094 a 0.873 0.873 0 0 1 0.52 1.255 l -0.16 0.292 c -0.892 1.64 0.901 3.434 2.541 2.54 l 0.292 -0.159 a 0.873 0.873 0 0 1 1.255 0.52 l 0.094 0.319 c 0.527 1.79 3.065 1.79 3.592 0 l 0.094 -0.319 a 0.873 0.873 0 0 1 1.255 -0.52 l 0.292 0.16 c 1.64 0.893 3.434 -0.902 2.54 -2.541 l -0.159 -0.292 a 0.873 0.873 0 0 1 0.52 -1.255 l 0.319 -0.094 c 1.79 -0.527 1.79 -3.065 0 -3.592 l -0.319 -0.094 a 0.873 0.873 0 0 1 -0.52 -1.255 l 0.16 -0.292 c 0.893 -1.64 -0.902 -3.433 -2.541 -2.54 l -0.292 0.159 a 0.873 0.873 0 0 1 -1.255 -0.52 z m -2.633 0.283 c 0.246 -0.835 1.428 -0.835 1.674 0 l 0.094 0.319 a 1.873 1.873 0 0 0 2.693 1.115 l 0.291 -0.16 c 0.764 -0.415 1.6 0.42 1.184 1.185 l -0.159 0.292 a 1.873 1.873 0 0 0 1.116 2.692 l 0.318 0.094 c 0.835 0.246 0.835 1.428 0 1.674 l -0.319 0.094 a 1.873 1.873 0 0 0 -1.115 2.693 l 0.16 0.291 c 0.415 0.764 -0.42 1.6 -1.185 1.184 l -0.291 -0.159 a 1.873 1.873 0 0 0 -2.693 1.116 l -0.094 0.318 c -0.246 0.835 -1.428 0.835 -1.674 0 l -0.094 -0.319 a 1.873 1.873 0 0 0 -2.692 -1.115 l -0.292 0.16 c -0.764 0.415 -1.6 -0.42 -1.184 -1.185 l 0.159 -0.291 A 1.873 1.873 0 0 0 1.945 8.93 l -0.319 -0.094 c -0.835 -0.246 -0.835 -1.428 0 -1.674 l 0.319 -0.094 A 1.873 1.873 0 0 0 3.06 4.377 l -0.16 -0.292 c -0.415 -0.764 0.42 -1.6 1.185 -1.184 l 0.292 0.159 a 1.873 1.873 0 0 0 2.692 -1.115 z" FillRule="Nonzero"/>
                                                        </GeometryDrawing.Geometry>
                                                    </GeometryDrawing>
                                                </DrawingGroup>
                                            </DrawingBrush.Drawing>
                                        </DrawingBrush>
                                    </Rectangle.OpacityMask>
                                </Rectangle>
                            </Viewbox>
                            <TextBlock Text="Settings" Margin="6,0,0,0"/>
                        </StackPanel>
                    </ListBoxItem>
                </ListBox>
            </Grid>
        </Border>

        <GridSplitter Grid.Column="1"
                      Margin="-2,0,-2,0"
                      ResizeBehavior="PreviousAndCurrent"
                      ResizeDirection="Columns"/>

        <TabControl x:Name="TabControl_Main"
                    Grid.Column="2"
                    Background="{DynamicResource LayerBackgroundBaseBrush}"
                    Style="{StaticResource HeaderlessTabControlStyle}">
            <TabItem>
                <view:DashboardTab/>
            </TabItem>
            <TabItem>
                <view:SheduleTab/>
            </TabItem>
            <TabItem>
                <view:TasksTab/>
            </TabItem>
            <TabItem>
                <view:SettingsTab/>
            </TabItem>
        </TabControl>
    </Grid>
</controls:CustomWindow>
